  FROM feedback-model:latest

  TEMPLATE """{{ if .System }}<|system|>
  {{ .System }}<|end|>
  {{ end }}{{ if .Prompt }}<|user|>
  {{ .Prompt }}<|end|>
  {{ end }}<|assistant|>
  {{ .Response }}<|end|>
  """

  PARAMETER temperature 0.3
  PARAMETER stop "<|end|>"
  PARAMETER stop "<|user|>"
  PARAMETER stop "<|system|>"